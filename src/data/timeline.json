 "lines": [
  {
   "id": "s1",
   "text": "Dans l'immobilier, chaque demande compte. Mais toutes ne peuvent pas attendre.",
   "start": 1.0,
   "end": 4.644,
   "duration": 3.644,
   "gap_before": 1.0
  },
  {
   "id": "s2",
   "text": "Entre les appels, les messages et les demandes de visites, répondre à chaque prospect peut vite devenir un défi.",
   "start": 7.3,
   "end": 12.964,
   "duration": 5.664,
   "gap_before": 2.66
  },
  {
   "id": "s3",
   "text": "Découvrez votre agent IA : il accompagne vos prospects, répond à leurs premières questions et recueille leurs besoins, même lorsque votre agence est fermée.",
   "start": 15.2,
   "end": 22.841,
   "duration": 7.641,
   "gap_before": 2.24
  },
  {
   "id": "s4a",
   "text": "Offrez une première réponse rapide à vos prospects, à tout moment.",
   "start": 24.3,
   "end": 27.599,
   "duration": 3.299,
   "gap_before": 1.46
  },
  {
   "id": "s4b",
   "text": "Identifiez les besoins de vos futurs acheteurs et locataires.",
   "start": 28.3,
   "end": 31.519,
   "duration": 3.219,
   "gap_before": 0.7
  },
  {
   "id": "s4c",
   "text": "Facilitez vos rendez-vous, selon les outils connectés à votre agent.",
   "start": 32.2,
   "end": 35.834,
   "duration": 3.634,
   "gap_before": 0.68
  },
  {
   "id": "s4d",
   "text": "Et gagnez du temps pour ce qui compte vraiment : vos clients.",
   "start": 36.0,
   "end": 38.689,
   "duration": 2.689,
   "gap_before": 0.17
  },
  {
   "id": "s5",
   "text": "Une solution personnalisable pour répondre aux besoins des agences immobilières martiniquaises et aux réalités de leur marché.",
   "start": 39.6,
   "end": 46.073,
   "duration": 6.473,
   "gap_before": 0.91
  },
  {
   "id": "s6",
   "text": "L'intelligence artificielle ne remplace pas votre expertise. Elle vous aide à mieux accompagner vos clients.",
   "start": 47.5,
   "end": 53.013,
   "duration": 5.513,
   "gap_before": 1.43
  },
  {
   "id": "s7",
   "text": "Demandez dès maintenant votre démonstration personnalisée.",
   "start": 55.1,
   "end": 57.995,
   "duration": 2.896,
   "gap_before": 2.09
  }
 ],
